# Copy to backend/.env and adjust. Every value below is the built-in default.

# --- model ------------------------------------------------------------------
# Trained detector weights. Relative paths resolve against the repository root.
MODEL_PATH=runs/detect/fire_smoke/weights/best.pt
# Torch device: empty = auto, or "cpu", "0", "0,1".
DEVICE=
# Confidence and NMS IoU thresholds applied to every request by default.
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.50
# Smoke-test the plumbing without trained weights. The COCO checkpoint below is
# downloaded by ultralytics and does NOT detect fire or smoke.
ALLOW_COCO_FALLBACK=false
COCO_FALLBACK_WEIGHTS=yolo11n.pt

# --- data and storage --------------------------------------------------------
UPLOAD_DIR=backend/uploads
OUTPUT_DIR=backend/outputs
JOB_DB_PATH=backend/jobs.sqlite3

# --- uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=100
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm

# --- video processing --------------------------------------------------------
# Run detection on every Nth frame; skipped frames reuse the previous boxes.
FRAME_STRIDE=3
# Safety cap on the number of frames a single job will process.
MAX_VIDEO_FRAMES=18000

# --- jobs and CORS ------------------------------------------------------------
JOB_RETENTION_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
